# Copie para .env (`npm run env`) e ajuste se precisar. Valores apenas para desenvolvimento local.

# Imagens (alinhe o PHP com o plano de hospedagem contratado)
WP_IMAGE_TAG=php8.3-apache
WP_CLI_PHP=php8.3

# Portas no host
WP_PORT=8080
MAILPIT_PORT=8025
ADMINER_PORT=8081

# Banco
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Instalação (credenciais de teste, só para o ambiente local)
WP_URL=http://localhost:8080
WP_TITLE="Flávio Emílio Cavalcanti"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@flavioemilio.test

# E-mail e anti-spam do formulário (fec-core/mail.php). Localmente tudo cai no Mailpit.
FEC_MAIL_FROM=site@flavioemilio.test
# Chaves PÚBLICAS de teste da Cloudflare (sempre aprovam). Em produção use as chaves do painel Turnstile.
FEC_TURNSTILE_SITEKEY=1x00000000000000000000AA
FEC_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
