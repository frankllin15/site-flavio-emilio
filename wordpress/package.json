{
  "name": "flavio-emilio-wordpress",
  "private": true,
  "type": "module",
  "description": "Ambiente local (Docker) e build do tema WordPress do site Flávio Emílio",
  "scripts": {
    "env": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')){fs.copyFileSync('.env.example','.env');console.log('.env criado')}else console.log('.env já existe')\"",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f wordpress",
    "share": "node bin/share.js",
    "share:stop": "docker compose --profile share stop tunnel",
    "wp": "docker compose run --rm wpcli wp",
    "setup": "docker compose run --rm wpcli sh /scripts/setup.sh",
    "seed:import": "docker compose run --rm wpcli wp eval-file --user=1 /seed/import.php",
    "seed": "npm run seed:import",
    "fonts": "node bin/copy-fonts.js",
    "build:css": "tailwindcss -i wp-content/themes/flavio-emilio/assets/src/main.css -o wp-content/themes/flavio-emilio/assets/dist/main.css --minify",
    "build:js": "esbuild wp-content/themes/flavio-emilio/assets/src/main.js --bundle --minify --target=es2019 --outfile=wp-content/themes/flavio-emilio/assets/dist/main.js",
    "build": "npm run fonts && npm run build:css && npm run build:editor && npm run build:js && npm run build:editor-js",
    "dev:css": "tailwindcss -i wp-content/themes/flavio-emilio/assets/src/main.css -o wp-content/themes/flavio-emilio/assets/dist/main.css --watch",
    "dev:js": "esbuild wp-content/themes/flavio-emilio/assets/src/main.js --bundle --sourcemap --target=es2019 --outfile=wp-content/themes/flavio-emilio/assets/dist/main.js --watch",
    "db:export": "docker compose run --rm wpcli wp db export - > backup.sql",
    "reset": "docker compose down -v",
    "icons": "node bin/build-icons.js",
    "og": "docker compose run --rm og-image",
    "build:editor": "tailwindcss -i wp-content/themes/flavio-emilio/assets/src/editor.css -o wp-content/themes/flavio-emilio/assets/dist/editor.css --minify",
    "build:editor-js": "esbuild wp-content/themes/flavio-emilio/assets/src/editor-share.js --minify --target=es2019 --outfile=wp-content/themes/flavio-emilio/assets/dist/editor-share.js"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "embla-carousel": "^8.6.0",
    "esbuild": "^0.28.2",
    "lucide-static": "^0.562.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  }
}
